{
  "permissions": {
    "allow": [
      "Bash(echo $PATH)",
      "Bash(grep:*)"
    ],
    "deny": [],
    "defaultMode": "default"
  },
  "model": "claude-opus-5[1m]",
  "availableModels": [
    "claude-opus-5[1m]",
    "opus",
    "sonnet",
    "haiku"
  ],
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/claudeconfig/hooks/brevity.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright@claude-code-lsps": true,
    "vtsls@claude-code-lsps": true,
    "rust-analyzer@claude-code-lsps": true,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "revenuecat@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-lsps": {
      "source": {
        "source": "git",
        "url": "https://github.com/Piebald-AI/claude-code-lsps.git"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false
}
