{
  "name": "ambient-loop",
  "summary": "Ambient loop: 6-12s holds, no effects, inkwash, built to replay.",
  "canvas": {"w": 1080, "h": 1920, "fps": 30},
  "timeline": "shots",
  "pacing": {"target_shot_s": 10.0, "min_shot_s": 6.0, "max_shot_s": 12.0, "order": "chronological", "source_gap_s": 20, "dupe_distance": 10},
  "effects": {"plan": "none", "flash_gain": 0.0, "rgb_shift": 0},
  "render": {"mode": "cuts", "rotate": false, "interpolate": "none", "base_zoom": 0.0,
             "encoder": {"cq": 21, "crf": 19, "maxrate": "40M", "bufsize": "120M"}},
  "grade": {"seed": "fixed", "base": "inkwash", "tech": ""},
  "scan": {"profile": "generic", "motion_floor": 0.002, "subject": "auto", "min_face_frac": 0.004},
  "gates": {"beat_offset_max": null, "density": false, "black": true, "freeze": false, "exposure_max": 3, "av_drift": true},
  "deliver": "master"
}
