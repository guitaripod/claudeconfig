          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal utilitza el micròfon per gravar notes de veu per a les teves entrades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal používá mikrofon k nahrávání hlasových poznámek k vašim záznamům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
