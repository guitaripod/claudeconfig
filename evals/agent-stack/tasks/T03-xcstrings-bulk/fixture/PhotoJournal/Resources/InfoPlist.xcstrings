        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal používa Face ID na odomknutie vašich súkromných albumov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal använder Face ID för att låsa upp dina privata album."
