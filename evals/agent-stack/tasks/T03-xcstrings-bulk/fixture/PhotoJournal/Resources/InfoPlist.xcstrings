  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal uses the camera to take photos for your journal entries."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم PhotoJournal Face ID لفتح ألبوماتك الخاصة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal използва Face ID, за да отключва личните ви албуми."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal utilitza Face ID per desbloquejar els teus àlbums privats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal používá Face ID k odemknutí vašich soukromých alb."
          }
        },
        "da": {
          "stringUnit": {
