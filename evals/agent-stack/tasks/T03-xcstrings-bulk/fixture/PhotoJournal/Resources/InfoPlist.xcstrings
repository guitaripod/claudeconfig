        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal używa Face ID, aby odblokować Twoje prywatne albumy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoJournal usa o Face ID para desbloquear seus álbuns privados."
