        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal utilise Face ID pour déverrouiller vos albums privés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal משתמש ב-Face ID כדי לבטל את נעילת האלבומים הפרטיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal आपके निजी एल्बम अनलॉक करने के लिए Face ID का उपयोग करता है।"
