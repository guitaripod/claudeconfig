    "sync.paused.lowpower": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف المزامنة مؤقتًا أثناء تشغيل وضع الطاقة المنخفضة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизирането е на пауза, докато е включен режимът за ниско захранване."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronització està en pausa mentre el mode d’energia baixa estigui activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace je pozastavena, dokud je zapnutý režim nízké spotřeby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering er sat på pause, mens lavenergitilstand er aktiveret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist pausiert, solange der Stromsparmodus aktiviert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός είναι σε παύση όσο είναι ενεργή η Λειτουργία χαμηλής ισχύος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is paused while Low Power Mode is on."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is paused while Low Power Mode is on."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is paused while Low Power Mode is on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is paused while Low Power Mode is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está en pausa mientras el modo de bajo consumo esté activado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está en pausa mientras el modo de bajo consumo esté activado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi on keskeytetty, kun virransäästötila on päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est suspendue tant que le mode Économie d’énergie est activé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est suspendue tant que le mode Économie d’énergie est activé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסנכרון מושהה כל עוד מצב חיסכון בסוללה פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम पावर मोड चालू होने पर सिंक रोक दिया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija je pauzirana dok je uključen način rada za nisku potrošnju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szinkronizálás szünetel, amíg az energiatakarékos mód be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi dijeda saat Mode Daya Rendah aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è in pausa finché la Modalità a basso consumo è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードがオンの間、同期は一時停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드가 켜져 있는 동안에는 동기화가 일시 중지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyegerakan dijeda semasa Mod Kuasa Rendah dihidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering er satt på pause mens strømsparingsmodus er på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is gepauzeerd zolang de energiebesparingsstand aan staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja jest wstrzymana, gdy włączony jest tryb niskiego zużycia energii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização fica pausada enquanto o Modo de Economia de Energia estiver ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está em pausa enquanto o Modo de Poupança de Energia estiver ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea este pusă pe pauză cât timp modul Economie de energie este activat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация приостановлена, пока включен режим энергосбережения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizácia je pozastavená, kým je zapnutý režim nízkej spotreby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen är pausad medan energisparläget är på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซิงค์หยุดชั่วคราวขณะเปิดโหมดประหยัดพลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu açıkken eşitleme duraklatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію призупинено, поки ввімкнено режим енергозбереження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ bị tạm dừng khi Chế độ Tiết kiệm Pin đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启低电量模式时，同步已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟低電量模式時，同步已暫停。"
          }
