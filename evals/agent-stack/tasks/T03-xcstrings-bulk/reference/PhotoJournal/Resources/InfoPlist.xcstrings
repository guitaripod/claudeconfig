{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم PhotoJournal الكاميرا لالتقاط الصور لإدخالات يومياتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal използва камерата, за да заснема снимки за записите в дневника ви."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal utilitza la càmera per fer fotos per a les teves entrades del diari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal používá fotoaparát k pořizování fotek do vašich záznamů v deníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal bruger kameraet til at tage billeder til dine dagbogsindlæg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal nutzt die Kamera, um Fotos für deine Tagebucheinträge aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το PhotoJournal χρησιμοποιεί την κάμερα για να τραβάει φωτογραφίες για τις καταχωρίσεις του ημερολογίου σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal uses the camera to take photos for your journal entries."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal uses the camera to take photos for your journal entries."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal uses the camera to take photos for your journal entries."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal uses the camera to take photos for your journal entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal usa la cámara para tomar fotos para tus entradas del diario."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal usa la cámara para tomar fotos para tus entradas del diario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal käyttää kameraa kuvien ottamiseen päiväkirjamerkintöihisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal utilise l’appareil photo pour prendre des photos pour vos entrées de journal."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal utilise la caméra pour prendre des photos pour vos entrées de journal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal משתמש במצלמה כדי לצלם תמונות עבור הרשומות שלך ביומן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal आपकी जर्नल प्रविष्टियों के लिए फ़ोटो लेने हेतु कैमरे का उपयोग करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal koristi kameru za snimanje fotografija za vaše unose u dnevnik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PhotoJournal a kamerát használja, hogy fényképeket készítsen a naplóbejegyzéseidhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal menggunakan kamera untuk mengambil foto bagi entri jurnal Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal usa la fotocamera per scattare foto per le voci del tuo diario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal は、ジャーナルのエントリー用に写真を撮影するためにカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal은 저널 항목에 쓸 사진을 찍기 위해 카메라를 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal menggunakan kamera untuk mengambil foto bagi entri jurnal anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal bruker kameraet til å ta bilder til dagbokoppføringene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal gebruikt de camera om foto’s te maken voor je dagboekitems."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal używa aparatu, aby robić zdjęcia do wpisów w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoJournal usa a câmera para tirar fotos para as suas entradas do diário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoJournal utiliza a câmara para tirar fotografias para as suas entradas do diário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal folosește camera pentru a face fotografii pentru intrările tale din jurnal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal использует камеру, чтобы делать фото для записей в дневнике."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal používa fotoaparát na fotografovanie pre vaše záznamy v denníku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal använder kameran för att ta foton till dina inlägg i dagboken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal ใช้กล้องเพื่อถ่ายภาพสำหรับรายการในเจอร์นัลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal, günlük girişlerin için fotoğraf çekmek amacıyla kamerayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal використовує камеру, щоб робити фото для записів у журналі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal sử dụng máy ảnh để chụp ảnh cho các mục nhật ký của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal 使用相机为你的日记条目拍摄照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal 使用相機為你的日記項目拍攝照片。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
