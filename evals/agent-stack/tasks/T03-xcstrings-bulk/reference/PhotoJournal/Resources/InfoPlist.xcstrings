        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal додає до вашого журналу місце, де було зроблено кожне фото."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal thêm vào nhật ký của bạn địa điểm chụp từng ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal 会将每张照片的拍摄地点添加到你的日记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
