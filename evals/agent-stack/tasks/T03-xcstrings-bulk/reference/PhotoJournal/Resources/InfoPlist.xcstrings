    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف PhotoJournal مكان التقاط كل صورة إلى يومياتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal добавя мястото, където е заснета всяка снимка, към дневника ви."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal afegeix al teu diari el lloc on es va fer cada foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal přidává do vašeho deníku místo, kde byla každá fotka pořízena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal tilføjer det sted, hvor hvert foto blev taget, til din dagbog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal fügt deinem Tagebuch den Ort hinzu, an dem jedes Foto aufgenommen wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το PhotoJournal προσθέτει στο ημερολόγιό σου το μέρος όπου τραβήχτηκε κάθε φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal adds the place where each photo was taken to your journal."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal adds the place where each photo was taken to your journal."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal adds the place where each photo was taken to your journal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal adds the place where each photo was taken to your journal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal añade a tu diario el lugar donde se tomó cada foto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal añade a tu diario el lugar donde se tomó cada foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal lisää päiväkirjaasi paikan, jossa kukin kuva otettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal ajoute à votre journal le lieu où chaque photo a été prise."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal ajoute à votre journal l’endroit où chaque photo a été prise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal מוסיף ליומן שלך את המקום שבו צולמה כל תמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal आपकी जर्नल में हर फ़ोटो लिए जाने की जगह जोड़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal u vaš dnevnik dodaje mjesto na kojem je svaka fotografija snimljena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PhotoJournal hozzáadja a naplóhoz, hol készült az egyes fényképek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal menambahkan lokasi tempat setiap foto diambil ke jurnal Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal aggiunge al tuo diario il luogo in cui è stata scattata ogni foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal は、各写真を撮影した場所をジャーナルに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal은 각 사진을 찍은 장소를 저널에 추가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal menambah tempat setiap foto diambil ke dalam jurnal anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal legger til stedet der hvert bilde ble tatt i dagboken din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal voegt de plek waar elke foto is gemaakt toe aan je dagboek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal dodaje do Twojego dziennika miejsce, w którym wykonano każde zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoJournal adiciona ao seu diário o local onde cada foto foi tirada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoJournal adiciona ao seu diário o local onde cada fotografia foi tirada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal adaugă în jurnalul tău locul în care a fost făcută fiecare fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal добавляет в ваш дневник место, где был сделан каждый снимок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoJournal pridáva do vášho denníka miesto, kde bola každá fotka urobená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
